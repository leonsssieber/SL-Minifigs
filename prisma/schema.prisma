// Lego Resale Shop — Database Schema
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (Auth.js v5 / NextAuth)
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  hashedPassword    String?
  isAdmin           Boolean   @default(false)
  image             String?
  // Legacy TOTP-Felder (nicht mehr verwendet — Email-2FA ist Standard für Admins)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  addresses             Address[]
  orders                Order[]
  wishlist              WishlistItem[]
  carts                 Cart[]
  auditLogs             AuditLog[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  emailTwoFactorCodes   EmailTwoFactorCode[]

  @@index([email])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    // bcrypt-hashed
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Kurzlebige 6-stellige Codes, die per E-Mail an Admins gesendet werden.
model EmailTwoFactorCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    // bcrypt-Hash des 6-stelligen Codes
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires    DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================
// PRODUCTS
// ============================================================

model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
}

// Vom Admin verwaltbare Liste der Produkt-Zustände. Product.condition
// speichert den `value` (z.B. "NEU"). Ist die Tabelle leer, fällt der Shop
// auf die eingebauten Standard-Zustände zurück (siehe lib/conditions.ts).
model ProductCondition {
  id        String   @id @default(cuid())
  value     String   @unique // wird in Product.condition gespeichert
  label     String           // Anzeigename, z.B. "Gebraucht – Fair"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String
  shortDescription String?
  categoryId       String
  condition        String
  // Zusätzlicher Hinweis, unabhängig vom Zustand: z.B. wenn ein Teil fehlt.
  incomplete       Boolean          @default(false)
  incompleteNote   String?          // optional: was fehlt, z.B. "Helm fehlt"
  price            Decimal
  comparePrice     Decimal?
  stockType        String        @default("UNIQUE")
  stockQuantity    Int              @default(1)
  sku              String?
  legoSetNumber    String?
  weightGrams      Int?
  shippingCategory String?          // z.B. "minifigure", "small_set", "large_set"
  customShippingMethodId String?
  active           Boolean          @default(true)
  featured         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  category               ProductCategory  @relation(fields: [categoryId], references: [id])
  customShippingMethod   ShippingMethod?  @relation(fields: [customShippingMethodId], references: [id])
  images                 ProductImage[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  wishlistItems          WishlistItem[]
  shippingOptions        ProductShippingOption[]

  @@index([slug])
  @@index([categoryId])
  @@index([active, featured])
  @@index([active, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  key       String? // UploadThing key zum Löschen
  alt       String?
  sortOrder Int     @default(0)
  width     Int?
  height    Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String?
  guestEmail      String?
  status          String     @default("PENDING")

  // Beträge (in CHF, alles als Decimal für Genauigkeit)
  subtotal        Decimal
  shippingCost    Decimal
  total           Decimal
  currency        String          @default("CHF")

  // Versand
  shippingMethodId   String?
  shippingMethodName String  // Snapshot

  // Lieferadresse (Snapshot für historische Korrektheit)
  shippingFirstName String
  shippingLastName  String
  shippingCompany   String?
  shippingStreet    String
  shippingStreet2   String?
  shippingZip       String
  shippingCity      String
  shippingCountry   String  @default("CH")
  shippingPhone     String?

  // Rechnungsadresse (optional, sonst gleich Lieferadresse)
  billingFirstName  String?
  billingLastName   String?
  billingCompany    String?
  billingStreet     String?
  billingStreet2    String?
  billingZip        String?
  billingCity       String?
  billingCountry    String?

  // Bezahlung
  paymentProvider String
  paymentStatus   String   @default("PENDING")
  paymentId       String?         // Stripe PaymentIntent / PayPal Order ID

  // Versand-Tracking
  trackingNumber   String?
  trackingProvider String?  // z.B. "Schweizerische Post"
  trackingUrl      String?

  // Notizen
  customerNotes String?
  adminNotes    String?

  // Tracking-Token für öffentliche Tracking-Seite (cuid2: nicht erratbar)
  publicToken String @unique @default(cuid(2))

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  items          OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([deletedAt])
}

model OrderItem {
  id          String           @id @default(cuid())
  orderId     String
  productId   String?

  // Snapshots (Produkt kann gelöscht werden)
  productName String
  productSku  String?
  condition   String
  unitPrice   Decimal
  quantity    Int
  lineTotal   Decimal
  imageUrl    String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ============================================================
// SHIPPING ENGINE
// ============================================================

model ShippingMethod {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Decimal
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules           ShippingRule[]
  orders          Order[]
  products        Product[]
  productOptions  ProductShippingOption[]

  @@index([active])
}

// Konfiguriert pro Produkt eine erlaubte Versandmethode mit optionaler
// "Empfohlen"-Markierung. Wenn ein Produkt keine Einträge hat, sind alle
// aktiven Methoden zulässig (Rückwärtskompatibilität).
model ProductShippingOption {
  id            String          @id @default(cuid())
  productId     String
  methodId      String
  isRecommended Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  method  ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([productId, methodId])
  @@index([productId])
  @@index([methodId])
}

model ShippingRule {
  id        String  @id @default(cuid())
  name      String
  methodId  String
  priority  Int     @default(0)  // höher = zuerst geprüft
  active    Boolean @default(true)

  // Bedingungen — alle gesetzten müssen zutreffen (AND)
  // Pro Versand-Kategorie (siehe Product.shippingCategory)
  minMinifigures Int?
  maxMinifigures Int?
  minSets        Int?
  maxSets        Int?
  minItems       Int?     // Gesamtanzahl
  maxItems       Int?
  minOrderValue  Decimal?
  maxOrderValue  Decimal?
  minWeightGrams Int?
  maxWeightGrams Int?

  // Preis-Override
  fixedPrice       Decimal?
  perItemSurcharge Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId])
  @@index([priority])
}

// ============================================================
// USER FEATURES
// ============================================================

model Address {
  id        String   @id @default(cuid())
  userId    String
  isDefault Boolean  @default(false)
  firstName String
  lastName  String
  company   String?
  street    String
  street2   String?
  zip       String
  city      String
  country   String   @default("CH")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================
// ANKAUF (Rückkauf von Kunden)
// ============================================================

model AnkaufRequest {
  id           String        @id @default(cuid())
  publicToken  String        @unique @default(cuid(2))
  name         String
  email        String
  phone        String?
  description  String
  desiredPrice Decimal       @db.Decimal(10, 2)
  status       String        @default("PENDING")
  // Admin-Antwort
  adminNote    String?
  offeredPrice Decimal?      @db.Decimal(10, 2)
  // Nach Annahme: Versandinfos des Einsenders
  shippingMethod String?
  trackingCode   String?
  // Abschluss
  payoutAmount Decimal?      @db.Decimal(10, 2)
  payoutNote   String?
  // Zeitstempel
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  respondedAt  DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?
  deletedAt    DateTime?

  images AnkaufImage[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

model AnkaufImage {
  id        String        @id @default(cuid())
  requestId String
  url       String
  key       String
  name      String?
  createdAt DateTime      @default(now())

  request AnkaufRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ============================================================
// SETTINGS & AUDIT
// ============================================================

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // z.B. "PRODUCT_DELETED", "ORDER_CANCELLED"
  entity    String?  // z.B. "Product", "Order"
  entityId  String?
  metadata  String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
