{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "prisma generate && next build",
  "functions": {
    "src/app/api/webhooks/stripe/route.ts": { "maxDuration": 30 },
    "src/app/api/paypal/capture/route.ts": { "maxDuration": 30 },
    "src/app/api/orders/[id]/invoice.pdf/route.ts": { "maxDuration": 30 },
    "src/app/api/admin/export/orders.csv/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/export/products.csv/route.ts": { "maxDuration": 60 }
  }
}
