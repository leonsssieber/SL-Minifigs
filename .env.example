# =============================================================================
# SL Minifigs — Environment Variables
# =============================================================================
# Copy this file to .env (local dev) and configure each variable in the Vercel
# dashboard for production. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech)
# -----------------------------------------------------------------------------
# 1. Create a free project at neon.tech
# 2. Copy the "Pooled connection" string into DATABASE_URL
# 3. Copy the "Direct connection" string into DIRECT_URL (used for migrations)
#
# When you connect Neon via Vercel's integration, both vars are set for you.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# (on Windows PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
# In production on Vercel this is auto-detected. If you self-host, set
# AUTH_TRUST_HOST=true and point AUTH_URL at your domain.

# -----------------------------------------------------------------------------
# Shop configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOP_NAME="SL Minifigs"
NEXT_PUBLIC_SHOP_URL="https://slminifigs.vercel.app"
NEXT_PUBLIC_CURRENCY="CHF"

# -----------------------------------------------------------------------------
# Vercel Blob — image storage (https://vercel.com/docs/storage/vercel-blob)
# -----------------------------------------------------------------------------
# 1. Vercel Dashboard → Project → Storage → Create → Blob
# 2. Token wird automatisch als Env-Var BLOB_READ_WRITE_TOKEN gesetzt.
# Lokal: aus dem Vercel-Dashboard kopieren oder via `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Email — Gmail SMTP (Nodemailer)
# -----------------------------------------------------------------------------
# Outgoing transactional email (order confirmations, password resets, contact
# form). For Gmail you MUST use an App Password (16 chars, no spaces):
#   1. https://myaccount.google.com/security  → enable 2-Step Verification
#   2. https://myaccount.google.com/apppasswords  → "Mail" → generate
#   3. Paste the 16-char password into SMTP_PASS below
#
# Gmail rate-limit: ~500 mails/day on a free account, ~2 000/day on Workspace.
# For higher volumes, switch to a transactional provider (Resend/Postmark/SES).

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="slminifigs@gmail.com"
SMTP_PASS=""

# "From" header on outgoing emails (default: SMTP_USER if not set)
EMAIL_FROM="SL Minifigs <slminifigs@gmail.com>"
# Reply-To header — also used as the inbox for the contact form
EMAIL_REPLY_TO="slminifigs@gmail.com"

# -----------------------------------------------------------------------------
# Stripe — credit card payments (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -----------------------------------------------------------------------------
# PayPal (https://developer.paypal.com/dashboard/applications)
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# "sandbox" while testing, "live" in production
PAYPAL_ENV="sandbox"

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting (https://console.upstash.com)
# -----------------------------------------------------------------------------
# REQUIRED in production. The in-memory fallback does not work on serverless
# (each Vercel invocation has its own memory), so brute-force protection only
# works correctly when Upstash is configured.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# First admin (used by `npm run db:seed`)
# -----------------------------------------------------------------------------
# CHANGE THE PASSWORD IMMEDIATELY AFTER FIRST LOGIN.
SEED_ADMIN_EMAIL="slminifigs@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
